{
  "name": "agentsoftware/laravel-unsplash",
  "description": "A laravel package for Unsplash API",
  "keywords": [
    "PHP",
    "Laravel",
    "unsplash",
    "Open Source",
    "spectre"
  ],
  "Homepage": "https://github.com/agentsoftware/laravel-unsplash",
  "version": "0.1.3",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "illuminate/contracts": "^12.48.1 || ^13.0",
    "illuminate/http": "^12.48.1 || ^13.0",
    "illuminate/support": "^12.48.1 || ^13.0",
    "psr/simple-cache": "^3.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.9.0 || ^11.0",
    "pestphp/pest": "^4.3.1",
    "pestphp/pest-plugin-laravel": "^4.0",
    "mockery/mockery": "^1.6",
    "larastan/larastan": "^3.9.1",
    "laravel/pint": "^1.15"
  },
  "autoload": {
    "psr-4": {
      "AgentSoftware\\Unsplash\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AgentSoftware\\Unsplash\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AgentSoftware\\Unsplash\\UnsplashServiceProvider"
      ],
      "aliases": {
        "Unsplash": "AgentSoftware\\Unsplash\\Facades\\Unsplash"
      }
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "phpstan": "vendor/bin/phpstan analyse",
    "pint": "vendor/bin/pint",
    "post-install-cmd": "git config core.hooksPath .githooks || true",
    "post-update-cmd": "git config core.hooksPath .githooks || true"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
